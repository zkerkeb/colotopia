# Google Gemini API key — required for image generation (Imagen 4)
GEMINI_API_KEY=AIza...

# Google AdSense publisher ID — required for ad monetization
# Format: pub-XXXXXXXXXXXXXXXX (16 digits)
# Get this from your AdSense account: https://www.google.com/adsense
PUBLIC_ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# Optional: path to the Astro project root
# Defaults to auto-detected parent of scripts/ directory
# ASTRO_ROOT=/path/to/coloriages

# Required for production builds (read-only credentials recommended).
# DATABASE_URL=postgres://user:password@host:5432/database
# Optional offline catalog snapshot for local validation only; never deployed.
# COLORING_SNAPSHOT=/absolute/path/colorings-snapshot.json
# Optional analytics; scripts load only after consent.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
