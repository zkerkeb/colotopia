---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColoringCard from '../../components/ColoringCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Pagination from '../../components/Pagination.astro';
import Hero from '../../components/Hero.astro';
import CategoriesSection from '../../components/CategoriesSection.astro';
import NewSection from '../../components/NewSection.astro';
import { getPublishableColoriages } from '../../lib/coloriages';
import { t, kidsCategories, adultCategories } from '../../lib/i18n';

const PAGE_SIZE = 24;
const locale = 'fr';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allColoriages = await getPublishableColoriages('fr');
  return paginate(allColoriages, { pageSize: 24 });
}

const { page } = Astro.props as { page: any };
const isFirstPage = page.currentPage === 1;
const canonical = Astro.url.href;
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://colotopia.com';
const translatedCount = (await getPublishableColoriages('en')).length;
const altUrl = page.currentPage > Math.ceil(translatedCount / 24) ? undefined : page.currentPage === 1
  ? `${siteUrl}/en/`
  : `${siteUrl}/en/${page.currentPage}/`;
const firstImage = page.data[0]?.data.image;
const ogImage = firstImage || undefined;

// Nouveaux: 10 most recent by createdAt (only on page 1)
let nouveaux: typeof page.data = [];
let nouveauxSlugs = new Set<string>();
let kidsCounts: Record<string, number> = {};
let adultCounts: Record<string, number> = {};
if (isFirstPage) {
  const allColoriages = await getPublishableColoriages('fr');
  nouveaux = allColoriages
    .filter((c: any) => c.data.createdAt && Date.now() - new Date(c.data.createdAt).getTime() < 30 * 86400000)
    .sort((a: any, b: any) => (b.data.createdAt || '').localeCompare(a.data.createdAt || ''))
    .slice(0, 10);
  nouveauxSlugs = new Set(nouveaux.map((c: any) => c.data.slug));

  for (const cat of kidsCategories) {
    kidsCounts[cat] = allColoriages.filter((c) => c.data.category === cat).length;
  }
  for (const cat of adultCategories) {
    adultCounts[cat] = allColoriages.filter((c) => c.data.category === cat).length;
  }
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.currentPage === 1
    ? 'Coloriages Gratuits à Imprimer'
    : `Coloriages Gratuits à Imprimer — Page ${page.currentPage}`,
  description: 'Des centaines de coloriages gratuits à imprimer pour les enfants.',
  url: Astro.url.href,
};
---

<BaseLayout
  locale={locale}
  title={page.currentPage > 1 ? `Coloriages Gratuits — Page ${page.currentPage}` : undefined}
  canonical={canonical}
  altUrl={altUrl}
  ogImage={ogImage}
  ogImageWidth={800}
  ogImageHeight={1100}
  structuredData={structuredData}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
>
  {!isFirstPage && <h1>{locale === 'fr' ? `Coloriages à imprimer — Page ${page.currentPage}` : `Coloring pages — Page ${page.currentPage}`}</h1>}
  {isFirstPage && <Hero locale={locale} previews={page.data.slice(0, 4).map((c: any) => ({ image: c.data.image, alt: c.data.alt, slug: c.data.slug }))} />}

  {isFirstPage && nouveaux.length > 0 && (
    <NewSection locale={locale} items={nouveaux} />
  )}

  {isFirstPage && <CategoriesSection locale={locale} kidsCounts={kidsCounts} adultCounts={adultCounts} />}

  <AdSlot adSlot="" format="horizontal" />

  <div class="audience-filter" role="group" aria-label="Filtrer par audience">
    <a class="filter-btn active" href="/fr/recherche/">{t('home.filter.all', locale)}</a>
    <a class="filter-btn" href="/fr/recherche/?audience=enfants">{t('audience.enfants', locale)}</a>
    <a class="filter-btn" href="/fr/recherche/?audience=adultes">{t('audience.adultes', locale)}</a>
  </div>

  <section class="coloring-grid" id="main-grid">
    {page.data.map((c: any, i: number) => (
      <ColoringCard
        title={c.data.title}
        slug={c.data.slug}
        image={c.data.image}
        alt={c.data.alt}
        locale={locale}
        audience={c.data.audience}
        category={c.data.category}
        isNew={nouveauxSlugs.has(c.data.slug)}
        isLCP={i === 0}
      />
    ))}
  </section>

  {page.data.length === 0 && (
    <p class="empty-state">{t('home.empty', locale)}</p>
  )}

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    locale={locale}
  />
</BaseLayout>



<style>
  .audience-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.4rem 1.1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-card);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
    font-family: var(--font-body);
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .coloring-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    color: #9ca3af;
    font-size: 1.1rem;
    padding: 4rem 0;
  }
</style>
