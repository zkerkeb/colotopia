---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColoringCard from '../../../components/ColoringCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Pagination from '../../../components/Pagination.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import PillarSection from '../../../components/PillarSection.astro';
import CategoryFaq from '../../../components/CategoryFaq.astro';
import RelatedCategories from '../../../components/RelatedCategories.astro';
import { categories, getCategoryLabel, getCategorySlug, ti, type Category } from '../../../lib/i18n';
import { getPublishableColoriages } from '../../../lib/coloriages';
import { getPillarContent, getRelatedCategories } from '../../../data/pillar-content';
import CategoryHero from '../../../components/CategoryHero.astro';
import EditorialContent from '../../../components/EditorialContent.astro';

const locale = 'fr';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const results = [];
  const allColoriages = await getPublishableColoriages('fr');
  for (const cat of categories) {
    const coloriages = allColoriages.filter((c) => c.data.category === cat);
    // Keep the category landing page and its empty state when moderation hides every drawing.
    const pages = paginate(coloriages, {
      params: { category: cat },
      props: { categoryKey: cat },
      pageSize: 24,
    });
    results.push(...pages);
  }
  return results;
}

const { page, categoryKey } = Astro.props as { page: any; categoryKey: Category };
const label = getCategoryLabel(categoryKey, locale);
const pillar = page.currentPage === 1 ? getPillarContent(categoryKey, locale) : null;
const relatedCats = getRelatedCategories(categoryKey, locale);

const pageDescription = `${page.total} coloriages ${label.toLowerCase()} gratuits à télécharger en PDF et à imprimer. Choisissez votre dessin et préparez une activité créative.`;
const seoText = ti(`category.${categoryKey}.seoText`, locale, {});
const hasSeoText = seoText !== `category.${categoryKey}.seoText`;
const canonical = Astro.url.href;
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://colotopia.com';
const enCatSlug = getCategorySlug(categoryKey, 'en');
const translatedCount = (await getPublishableColoriages('en')).filter(c => c.data.category === categoryKey).length;
const altUrl = page.currentPage > Math.max(1, Math.ceil(translatedCount / 24)) ? undefined : page.currentPage === 1
  ? `${siteUrl}/en/${enCatSlug}/`
  : `${siteUrl}/en/${enCatSlug}/${page.currentPage}/`;
const firstImage = page.data[0]?.data.image;
const ogImage = firstImage || undefined;

const itemListElements = page.data.map((c: any, i: number) => ({
  '@type': 'ListItem',
  position: (page.currentPage - 1) * page.size + i + 1,
  url: `${siteUrl}/fr/coloriage/${c.data.slug}/`,
  name: c.data.title,
  image: c.data.image,
}));

const collectionPage = {
  '@type': 'CollectionPage',
  name: page.currentPage === 1
    ? `Coloriages ${label}`
    : `Coloriages ${label} — Page ${page.currentPage}`,
  description: pageDescription,
  url: Astro.url.href,
  numberOfItems: page.total,
};

const itemList = {
  '@type': 'ItemList',
  numberOfItems: page.data.length,
  itemListElement: itemListElements,
};

const graphEntries: any[] = [collectionPage, itemList];

if (pillar && pillar.faq.length > 0) {
  graphEntries.push({
    '@type': 'FAQPage',
    mainEntity: pillar.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphEntries,
};
---

<BaseLayout
  title={page.currentPage > 1
    ? `Coloriages ${label} — Page ${page.currentPage}`
    : `Coloriages ${label}`}
  description={pageDescription}
  locale={locale}
  canonical={canonical}
  altUrl={altUrl}
  ogImage={ogImage}
  ogImageWidth={800}
  ogImageHeight={1100}
  structuredData={structuredData}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
  category={categoryKey}
>
  <CategoryHero category={categoryKey} title={`Coloriages ${label}`} />
  <div class="category-count-bar">
    <span>{page.total} coloriages</span>
  </div>
  <div class="category-content">
    <Breadcrumb locale={locale} currentPage={`Coloriages ${label}`} />

  {pillar && (
    <p class="pillar-anchor-link">
      <a href="#en-savoir-plus">En savoir plus sur les coloriages {label.toLowerCase()}</a>
    </p>
  )}

  <AdSlot adSlot="" format="horizontal" />

  <section class="coloring-grid">
    {page.data.map((c: any, i: number) => (
      <ColoringCard
        title={c.data.title}
        slug={c.data.slug}
        image={c.data.image}
        alt={c.data.alt}
        locale={locale}
        audience={c.data.audience}
        category={c.data.category}
        isLCP={i === 0}
      />
    ))}
  </section>

  {page.data.length === 0 && (
    <p class="empty-state">
      {ti('category.empty', locale, { label: label.toLowerCase() })}
    </p>
  )}

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    locale={locale}
  />

  {page.currentPage === 1 && relatedCats.length > 0 && (
    <RelatedCategories locale={locale} categories={relatedCats} />
  )}

  {pillar && (
    <div id="en-savoir-plus">
      <PillarSection locale={locale} pillar={pillar} categoryLabel={label} />
    </div>
  )}

  {pillar && pillar.faq.length > 0 && (
    <CategoryFaq locale={locale} faq={pillar.faq} categoryLabel={label} />
  )}

  {page.currentPage === 1 && hasSeoText && !pillar && (
    <div class="seo-content"><EditorialContent html={seoText} /></div>
  )}
  </div>
</BaseLayout>

<style>
  .category-count-bar {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary, #6b7280);
    font-weight: var(--font-weight-semibold);
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
  }

  /* Page content */
  .category-content {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .coloring-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .coloring-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .coloring-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .pillar-anchor-link {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--font-size-sm);
  }

  .pillar-anchor-link a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-primary-light);
    text-underline-offset: 2px;
  }

  .pillar-anchor-link a:hover {
    color: #4f46e5;
    text-decoration-color: #6366f1;
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    padding: var(--space-16) 0;
  }

  .seo-content {
    margin-top: var(--space-10);
    padding: var(--space-6);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .seo-content :global(h2) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: var(--space-6) 0 var(--space-3);
  }

  .seo-content :global(h2:first-child) {
    margin-top: 0;
  }

  .seo-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-primary-light);
    text-underline-offset: 2px;
  }

  .seo-content :global(a:hover) {
    color: #4f46e5;
    text-decoration-color: #6366f1;
  }
</style>
