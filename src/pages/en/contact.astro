---
import BaseLayout from '../../layouts/BaseLayout.astro';

const canonical = 'https://colotopia.com/en/contact/';
const altUrl = 'https://colotopia.com/fr/contact/';
---

<BaseLayout
  locale="en"
  title="Contact"
  description="Contact the Colotopia team: questions, suggestions, partnerships, reports. We reply to all messages within 2 business days."
  canonical={canonical}
  altUrl={altUrl}
>
  <article class="legal-page">
    <h1>Contact us</h1>

    <p class="lead">
      A question about a coloring page, an illustration request, an editorial partnership or a
      report? We're listening.
    </p>

    <h2>By email</h2>
    <p>
      For any request, write to us at:
      <a href="mailto:contact@colotopia.com">contact@colotopia.com</a>.
      We usually reply within 2 business days.
    </p>

    <h2>Common contact reasons</h2>
    <ul>
      <li><strong>Coloring page suggestion</strong>: a theme you'd love to see? Let us know.</li>
      <li><strong>Report</strong>: a problematic image, a broken link, a typo? We'll fix it.</li>
      <li><strong>Partnership / press</strong>: brands, schools, media — tell us about your project.</li>
      <li><strong>Using our coloring pages</strong>: for commercial or institutional use, contact us
        for permission.</li>
      <li><strong>GDPR rights</strong>: access, correction or deletion of your personal data (see our
        <a href="/en/privacy/">privacy policy</a>).</li>
    </ul>

    <h2>Site publisher</h2>
    <p>
      Colotopia is an independent editorial project. For any legal or official request, please
      specify the subject in your email and provide the necessary supporting documents.
    </p>

    <h2>Social media</h2>
    <p>
      You can also follow us on
      <a href="https://pinterest.com/colotopia" rel="noopener noreferrer" target="_blank">Pinterest</a>
      and
      <a href="https://instagram.com/colotopia" rel="noopener noreferrer" target="_blank">Instagram</a>
      to discover our latest creations.
    </p>
  </article>
</BaseLayout>

<style>
  .legal-page {
    max-width: 760px;
    margin: 0 auto;
  }
  .legal-page h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: #1f2937;
  }
  .legal-page .lead {
    font-size: 1.125rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .legal-page h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
    color: #1f2937;
  }
  .legal-page p {
    color: #4b5563;
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .legal-page ul {
    color: #4b5563;
    line-height: 1.75;
    margin: 0 0 1rem 1.25rem;
  }
  .legal-page li {
    margin-bottom: 0.5rem;
  }
  .legal-page a {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
