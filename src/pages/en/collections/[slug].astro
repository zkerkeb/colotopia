---
import CollectionPage from "../../../components/CollectionPage.astro";
import { collectionDefinitions } from "../../../lib/collections";
export function getStaticPaths() {
  return collectionDefinitions.map((c) => ({
    params: { slug: c.en.slug },
    props: { id: c.id },
  }));
}
const { id } = Astro.props;
---

<CollectionPage locale="en" id={id} />
