---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishableColoriages } from '../../lib/coloriages';
import CategoryCard from '../../components/CategoryCard.astro';
import { categoryArtwork } from '../../lib/category-artwork';
import { t, categoryIcons, categoryColors, kidsCategories, adultCategories, getCategoryLabel, getCategorySlug, getLocalePath, type Category } from '../../lib/i18n';

const locale = 'en';

const allColoriages = await getPublishableColoriages('en');

// Use the same reviewed illustrations as the homepage and category headers.
function buildCategoryData(cats: readonly string[]) {
  return cats.map((cat) => {
    const items = allColoriages.filter((c) => c.data.category === cat);
    return {
      key: cat as Category,
      label: getCategoryLabel(cat as Category, locale),
      href: getLocalePath(locale, `/${getCategorySlug(cat as Category, locale)}`),
      count: items.length,
    };
  });
}

const kidsData = buildCategoryData(kidsCategories);
const adultsData = buildCategoryData(adultCategories);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('categories.title', locale),
  description: t('categories.description', locale),
  url: Astro.url.href,
};
---

<BaseLayout
  title={t('categories.title', locale)}
  description={t('categories.description', locale)}
  locale={locale}
  canonical="https://colotopia.com/en/categories/"
  altUrl="https://colotopia.com/fr/categories/"
  structuredData={structuredData}
>
  <section class="hero">
    <h1>{t('categories.title', locale)}</h1>
    <p>{t('categories.description', locale)}</p>
  </section>

  <div class="tabs" role="tablist">
    <button class="tab active" role="tab" aria-selected="true" data-tab="kids">
      {t('audience.enfants', locale)}
      <span class="tab-count">{kidsData.length}</span>
    </button>
    <button class="tab" role="tab" aria-selected="false" data-tab="adults">
      {t('audience.adultes', locale)}
      <span class="tab-count">{adultsData.length}</span>
    </button>
  </div>

  <section class="category-grid" id="tab-kids" role="tabpanel">
    {kidsData.map((cat) => (
      <CategoryCard
        name={cat.label}
        emoji={categoryIcons[cat.key]}
        count={cat.count}
        color={categoryColors[cat.key].light}
        href={cat.href}
        locale={locale}
        image={categoryArtwork(cat.key)}
        heading
      />
    ))}
  </section>

  <section class="category-grid hidden" id="tab-adults" role="tabpanel">
    {adultsData.map((cat) => (
      <CategoryCard
        name={cat.label}
        emoji={categoryIcons[cat.key]}
        count={cat.count}
        color={categoryColors[cat.key].light}
        href={cat.href}
        locale={locale}
        image={categoryArtwork(cat.key)}
        heading
      />
    ))}
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
    const panels = {
      kids: document.getElementById('tab-kids'),
      adults: document.getElementById('tab-adults'),
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab as 'kids' | 'adults';

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) {
            panel.classList.toggle('hidden', key !== target);
          }
        });
      });
    });
  });
</script>

<style>
  .hero {
    text-align: center;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, #fce7f3 0%, #fef3c7 35%, #d1fae5 65%, #e0e7ff 100%);
    border-radius: 20px;
    padding: 2.5rem 1.5rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: #1a1a1a;
  }

  .hero p {
    font-size: 1.1rem;
    color: #4b5563;
    max-width: 600px;
    margin: 0 auto;
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 1.75rem;
    }
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .tab {
    padding: 0.625rem 1.5rem;
    border: 2px solid #e5e7eb;
    border-radius: 50px;
    background: white;
    font-size: 1rem;
    font-weight: 600;
    color: #4b5563;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: inherit;
  }

  .tab:hover {
    border-color: #f9a8d4;
    color: #e8437f;
  }

  .tab.active {
    background: #e8437f;
    border-color: #e8437f;
    color: white;
  }

  .tab-count {
    font-size: 0.8rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.08);
    padding: 0.125rem 0.5rem;
    border-radius: 50px;
  }

  .tab.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .category-grid.hidden {
    display: none;
  }

</style>
