---
import Brand from "./Brand.astro";
import {
  t,
  getPrivacyPath,
  getTermsPath,
  getAboutPath,
  getContactPath,
  type Locale,
} from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const fr = locale === "fr";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <Brand locale={locale} />
      <p>
        {fr
          ? "Une feuille, des couleurs, un moment à soi."
          : "A page, some colors, a moment for yourself."}
      </p>
    </div>
    <nav aria-label={fr ? "Explorer le site" : "Explore the site"}>
      <a href={`/${locale}/categories/`}>
        {fr ? "Tous les thèmes" : "All themes"}
      </a>
      <a href={`/${locale}/collections/`}>Collections PDF</a>
      <a href={`/${locale}/categories/#adults`}>
        {fr ? "Coloriages adultes" : "Adult coloring pages"}
      </a>
      <a href={`/${locale}/blog/`}>
        {fr ? "Idées et conseils" : "Ideas and tips"}
      </a>
    </nav>
    <nav aria-label={fr ? "Informations" : "Information"}>
      <a href={getAboutPath(locale)}>{t("footer.about", locale)}</a>
      <a href={getContactPath(locale)}>{t("footer.contact", locale)}</a>
      <a href={getPrivacyPath(locale)}>{t("footer.privacy", locale)}</a>
      <a href={getTermsPath(locale)}>{t("footer.terms", locale)}</a>
      <button
        type="button"
        onclick="if(window.colotopiaConsent)window.colotopiaConsent.open();"
      >
        {t("footer.manageCookies", locale)}
      </button>
    </nav>
  </div>
  <div class="footer-bottom">
    © {new Date().getFullYear()} Colotopia{" "}
    <span>
      {fr
        ? "Coloriages gratuits · Sans inscription"
        : "Free coloring pages · No sign-up"}
    </span>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: 3rem;
    padding: 2.5rem 1rem 1rem;
    background: #f1edf8;
    border-top: 1px solid #e5dfef;
  }
  .footer-inner,
  .footer-bottom {
    max-width: 1168px;
    margin: auto;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
  }
  p {
    max-width: 21rem;
    margin-top: 0.75rem;
    color: #625e71;
    font-size: 0.95rem;
  }
  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  nav a,
  button {
    color: #494356;
    font-size: 0.9rem;
  }
  button {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  button:hover {
    text-decoration: underline;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #ddd6e9;
    color: #625e71;
    font-size: 0.8rem;
  }
  @media (max-width: 600px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .footer-inner > div {
      grid-column: 1/-1;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
