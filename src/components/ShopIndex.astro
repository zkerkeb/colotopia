---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from './BookCard.astro';
import ShopTracking from './ShopTracking.astro';
import { getBooks, shopPath } from '../lib/shop';
import type { Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const fr = locale === 'fr';
const books = getBooks(locale);
const groups = [
  { id: 'children', title: fr ? 'Pour les enfants' : 'For children' },
  { id: 'adults', title: fr ? 'Pour les adultes' : 'For adults' },
  { id: 'professional', title: fr ? 'Pour les professionnels' : 'For businesses' },
];
---
<BaseLayout locale={locale} title={fr ? 'Jeux et cahiers de coloriage à imprimer' : 'Printable coloring books and activity packs'} description={fr ? 'Jeux de Noël, sets de table, enquêtes, activités de voyage et coloriages Colotopia. Extraits PDF gratuits et carnets complets à acheter sur Etsy.' : 'Explore Colotopia coloring books and French-language activity packs for holidays, birthdays and travel. Free PDF samples and complete books on Etsy.'} canonical={`https://colotopia.com${shopPath(locale)}`} altUrl={`https://colotopia.com${shopPath(fr ? 'en' : 'fr')}`}>
  <nav class="crumb" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}><a href={`/${locale}/`}>{fr ? 'Accueil' : 'Home'}</a><span aria-hidden="true"> / </span><span>{fr ? 'Cahiers' : 'Books'}</span></nav>
  <h1>{fr ? 'Les cahiers et jeux Colotopia' : 'Colotopia books and games'}</h1>
  <p class="format">{fr ? 'PDF A4 + US Letter · Achat sur Etsy' : 'A4 + US Letter PDFs · Buy on Etsy'}</p>
  {groups.map(group => {
    const selection = books.filter(book => book.group === group.id);
    return selection.length > 0 && <section class="shop-group" aria-labelledby={`shop-${group.id}`}><h2 id={`shop-${group.id}`}>{group.title}</h2><div class="shop-grid">{selection.map(book => <BookCard book={book} />)}</div></section>;
  })}
  <p class="price-note">{fr ? 'Prix en euros indicatifs : Etsy affiche le montant final dans votre devise. Produits numériques, sans envoi postal.' : 'Etsy displays the final price, currency and applicable taxes. Digital products; nothing is shipped.'}</p>
  <a class="free-link" href={`/${locale}/categories/`}>{fr ? 'Parcourir les coloriages gratuits' : 'Browse free coloring pages'} →</a>
</BaseLayout>
<ShopTracking />
<style>
  .crumb { font-size: .9rem; color: #6a6074; margin-bottom: 1.75rem; }
  h1 { font-family: var(--font-display); font-weight: 400; color: #302443; }
  .format { color: #625672; margin: .65rem 0 2rem; }
  .shop-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.25rem; }
  .shop-group { margin-bottom: 2.5rem; }
  .shop-group h2 { margin-bottom: 1rem; font-size: 1.4rem; color: #302443; }
  .price-note { margin: 1.5rem 0; max-width: 52rem; color: #625672; font-size: .9rem; }
  .free-link { font-weight: 800; }
  @media (max-width: 600px) { .shop-grid { grid-template-columns: 1fr; } h1 { font-size: 2rem; } }
</style>
