---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  showSubmit?: boolean;
}

const { locale, showSubmit = false } = Astro.props;

const action = locale === 'fr' ? '/fr/recherche/' : '/en/search/';
const submitLabel = locale === 'fr' ? 'Chercher' : 'Search';
const ariaLabel = locale === 'fr' ? 'Rechercher un coloriage' : 'Search for a coloring page';
const noResults = locale === 'fr' ? 'Aucun résultat' : 'No results';
const indexUrl = `/${locale}/search-index.json`;

const placeholdersFr = [
  'Cherche un dinosaure…',
  'Cherche une princesse…',
  'Cherche un robot…',
  'Cherche un mandala…',
  'Cherche un animal…',
];
const placeholdersEn = [
  'Search for a dinosaur…',
  'Search for a princess…',
  'Search for a robot…',
  'Search for a mandala…',
  'Search for an animal…',
];
const defaultPlaceholder = locale === 'fr' ? placeholdersFr[0] : placeholdersEn[0];
const placeholders = JSON.stringify(locale === 'fr' ? placeholdersFr : placeholdersEn);
---

<form
  class:list={['search-bar', 'js-search-bar', showSubmit && 'search-bar--hero']}
  action={action}
  method="get"
  data-index-url={indexUrl}
  data-no-results={noResults}
  data-placeholders={placeholders}
  role="search"
>
  <div class="search-input-wrapper">
    <span class="search-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
    </span>
    <input
      type="search"
      name="q"
      class="search-input"
      placeholder={defaultPlaceholder}
      autocomplete="off"
      aria-label={ariaLabel}
      aria-expanded="false"
    />
    <ul class="search-results" role="listbox" hidden></ul>
  </div>
  {showSubmit && (
    <button type="submit" class="btn-primary search-submit">{submitLabel}</button>
  )}
</form>

<style>
  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1;
    max-width: 400px;
    width: 100%;
  }

  .search-bar--hero {
    max-width: 560px;
  }

  @media (max-width: 480px) {
    .search-bar { gap: .5rem; }
    .search-submit { padding: 14px 16px; font-size: .9rem; }
  }

  .search-input-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .search-input {
    width: 100%;
    padding: 12px var(--space-4) 12px 2.75rem;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--shadow-card);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    color: var(--color-text);
    outline: none;
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-focus);
  }

  .search-input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    margin: 0;
    padding: var(--space-1) 0;
    z-index: var(--z-dropdown);
    max-height: 320px;
    overflow-y: auto;
  }

  .search-results[hidden] {
    display: none;
  }

  .search-results :global(.search-result-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .search-results :global(.search-result-item:hover),
  .search-results :global(.search-result-item[aria-selected="true"]) {
    background: var(--color-primary-light);
  }

  .search-results :global(.search-result-item:hover .search-result-title),
  .search-results :global(.search-result-item[aria-selected="true"] .search-result-title) {
    color: var(--color-primary);
  }

  .search-results :global(.search-result-title) {
    font-weight: var(--font-weight-medium);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-result-category) {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    background: var(--color-bg-subtle);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .search-results :global(.search-no-results) {
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    pointer-events: none;
  }
</style>

<script>
  import { loadSearchIndex, searchCatalog, type SearchItem } from '../lib/search';
  import { track } from '../lib/analytics';
  document.querySelectorAll<HTMLFormElement>('.js-search-bar').forEach((bar, instance) => {
    const input = bar.querySelector<HTMLInputElement>('.search-input')!;
    const results = bar.querySelector<HTMLUListElement>('.search-results')!;
    const fr = bar.action.includes('/fr/');
    results.id = `search-suggestions-${instance}`;
    input.setAttribute('role', 'combobox'); input.setAttribute('aria-autocomplete', 'list'); input.setAttribute('aria-controls', results.id);
    let selected = -1, revision = 0, timer: ReturnType<typeof setTimeout>;
    function close() { results.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); selected = -1; }
    function render(items: SearchItem[], error = false) {
      results.replaceChildren(); selected = -1; input.removeAttribute('aria-activedescendant');
      if (!items.length) {
        const li = document.createElement('li'); li.className = 'search-no-results';
        li.textContent = error ? (fr ? 'Recherche indisponible. Réessayez.' : 'Search unavailable. Try again.') : bar.dataset.noResults!; results.append(li);
      }
      items.slice(0, 8).forEach((item, i) => {
        const li = document.createElement('li'); li.setAttribute('role', 'presentation');
        const a = document.createElement('a'); a.href = item.url; a.className = 'search-result-item'; a.id = `${results.id}-${i}`; a.setAttribute('role', 'option'); a.setAttribute('aria-selected', 'false');
        for (const [className, label] of [['search-result-title', item.title], ['search-result-category', item.categoryLabel || item.category]]) {
          const span = document.createElement('span'); span.className = className; span.textContent = label; a.append(span);
        }
        a.addEventListener('click', () => track('search_select', { search_term: input.value.trim(), result_url: item.url }));
        li.append(a); results.append(li);
      });
      results.hidden = false; input.setAttribute('aria-expanded', 'true');
    }
    input.addEventListener('input', () => {
      clearTimeout(timer); const id = ++revision;
      if (!input.value.trim()) { close(); return; }
      timer = setTimeout(async () => {
        try { const index = await loadSearchIndex(bar.dataset.indexUrl!); if (id === revision && document.activeElement === input) render(searchCatalog(index, input.value)); }
        catch { if (id === revision && document.activeElement === input) render([], true); }
      }, 180);
    });
    input.addEventListener('keydown', event => {
      if (results.hidden) return;
      const links = [...results.querySelectorAll<HTMLAnchorElement>('.search-result-item')];
      if (event.key === 'Escape') { ++revision; close(); return; }
      if (event.key === 'Enter' && selected >= 0) { event.preventDefault(); links[selected]?.click(); }
      if (['ArrowDown', 'ArrowUp'].includes(event.key) && links.length) {
        event.preventDefault(); selected = (selected + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
        links.forEach((a, i) => a.setAttribute('aria-selected', String(i === selected)));
        input.setAttribute('aria-activedescendant', links[selected].id); links[selected].scrollIntoView({ block: 'nearest' });
      }
    });
    bar.addEventListener('focusout', event => { if (!bar.contains(event.relatedTarget as Node)) { ++revision; close(); } });
    document.addEventListener('click', event => { if (!bar.contains(event.target as Node)) { ++revision; close(); } });
  });
  // Preserve old search URLs shared before the dedicated results page existed.
  const legacyQuery = new URLSearchParams(location.search).get('q');
  if (legacyQuery && /^\/(fr|en)\/?$/.test(location.pathname)) {
    location.replace(`${location.pathname.startsWith('/fr') ? '/fr/recherche/' : '/en/search/'}?q=${encodeURIComponent(legacyQuery)}`);
  }
</script>
