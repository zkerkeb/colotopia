---
import type { Locale, Category } from '../lib/i18n';
import { getCategoryLabel, getCategorySlug, getLocalePath, categoryIcons, categoryColors } from '../lib/i18n';
import { cdnCategoryIcon } from '../lib/cdn';
import CategoryCard from './CategoryCard.astro';

interface Props {
  locale: Locale;
  categories: Category[];
}

const { locale, categories } = Astro.props;

const title = locale === 'fr'
  ? 'Catégories similaires'
  : 'Related Categories';
---

{categories.length > 0 && (
  <section class="related-categories">
    <h2>{title}</h2>
    <div class="related-grid">
      {categories.map((cat) => (
        <CategoryCard
          name={getCategoryLabel(cat, locale)}
          slug={getCategorySlug(cat, locale)}
          emoji={categoryIcons[cat]}
          count={0}
          color={categoryColors[cat]?.light ?? '#f0ebff'}
          href={getLocalePath(locale, `/${getCategorySlug(cat, locale)}`)}
          locale={locale}
          image={cdnCategoryIcon(cat)}
        />
      ))}
    </div>
  </section>
)}

<style>
  .related-categories {
    margin-top: 3rem;
  }

  .related-categories h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #1f2937;
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
