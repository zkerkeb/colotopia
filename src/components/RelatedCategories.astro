---
import type { Locale, Category } from '../lib/i18n';
import { getCategoryLabel, getCategorySlug, getLocalePath, categoryIcons, categoryColors } from '../lib/i18n';
import { categoryArtwork } from '../lib/category-artwork';
import { getPublishableColoriages } from '../lib/coloriages';
import { canonicalCategory } from '../lib/catalog';
import CategoryCard from './CategoryCard.astro';

interface Props {
  locale: Locale;
  categories: Category[];
}

const { locale, categories } = Astro.props;
const catalog = await getPublishableColoriages(locale);
const counts = new Map<string, number>();
for (const c of catalog) counts.set(c.data.category, (counts.get(c.data.category) ?? 0) + 1);
const visibleCategories = [...new Set(categories.map(c => canonicalCategory(c) as Category))].filter(c => counts.has(c));

const title = locale === 'fr'
  ? 'Catégories similaires'
  : 'Related Categories';
---

{visibleCategories.length > 0 && (
  <section class="related-categories">
    <h2>{title}</h2>
    <div class="related-grid">
      {visibleCategories.map((cat) => (
        <CategoryCard
          name={getCategoryLabel(cat, locale)}
          slug={getCategorySlug(cat, locale)}
          emoji={categoryIcons[cat]}
          count={counts.get(cat)!}
          color={categoryColors[cat]?.light ?? '#f0ebff'}
          href={getLocalePath(locale, `/${getCategorySlug(cat, locale)}`)}
          locale={locale}
          image={categoryArtwork(cat)}
        />
      ))}
    </div>
  </section>
)}

<style>
  .related-categories {
    margin-top: 3rem;
  }

  .related-categories h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #1f2937;
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
