---
import type { Locale } from '../lib/i18n';
interface Props { image: string; title: string; locale: Locale }
const { image, title, locale } = Astro.props;
const fr = locale === 'fr';
---
<div class="pdf-action">
  <button id="pdf-download-btn" type="button" class="btn-primary btn-lg" data-image={image} data-title={title} data-locale={locale} aria-describedby="pdf-status">
    <span>{fr ? 'Télécharger le PDF' : 'Download PDF'}</span>
  </button>
  <p id="pdf-status" role="status" aria-live="polite"></p>
  <a href={image} target="_blank" rel="noopener noreferrer">{fr ? 'Ouvrir l’image PNG' : 'Open PNG image'}</a>
</div>
<script>
  import { fitA4, pdfFilename } from '../lib/pdf';
  import { track } from '../lib/analytics';
  const button = document.querySelector<HTMLButtonElement>('#pdf-download-btn');
  if (button) {
    const status = document.querySelector<HTMLElement>('#pdf-status')!;
    const label = button.querySelector('span')!, original = label.textContent;
    button.addEventListener('click', async () => {
      const fr = button.dataset.locale === 'fr';
      button.disabled = true; button.setAttribute('aria-busy', 'true'); label.textContent = fr ? 'Préparation…' : 'Preparing…'; status.textContent = '';
      let objectUrl: string | undefined;
      try {
        const [response, { jsPDF }] = await Promise.all([fetch(new URL(button.dataset.image!).hostname === 'cdn.colotopia.com' ? `/cdn${new URL(button.dataset.image!).pathname}` : button.dataset.image!, { signal: AbortSignal.timeout(30_000) }), import('jspdf')]);
        if (!response.ok) throw new Error('Image unavailable');
        const blob = await response.blob();
        if (!blob.type.startsWith('image/')) throw new Error('Invalid image');
        objectUrl = URL.createObjectURL(blob);
        const img = new Image(); img.src = objectUrl; await img.decode();
        const canvas = document.createElement('canvas'); canvas.width = img.naturalWidth; canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d'); if (!ctx) throw new Error('Canvas unavailable');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.drawImage(img, 0, 0);
        const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
        const box = fitA4(canvas.width, canvas.height);
        doc.addImage(canvas.toDataURL('image/jpeg', .95), 'JPEG', box.x, box.y, box.width, box.height);
        doc.setProperties({ title: button.dataset.title!, creator: 'Colotopia' });
        const filename = pdfFilename(button.dataset.title!);
        await doc.save(filename, { returnPromise: true });
        status.textContent = fr ? 'PDF prêt. Retrouvez-le dans vos téléchargements.' : 'PDF ready. Check your downloads.';
        // The browser accepted the file; this does not prove it was saved or printed.
        track('pdf_download', { file_name: filename, coloring_slug: location.pathname.split('/').filter(Boolean).pop() });
      } catch {
        status.textContent = fr ? 'Le PDF n’a pas pu être préparé. Réessayez ou ouvrez l’image PNG ci-dessous.' : 'The PDF could not be prepared. Try again or open the PNG image below.';
      } finally {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        button.disabled = false; button.removeAttribute('aria-busy'); label.textContent = original;
      }
    });
  }
</script>
<style>
  .pdf-action { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; }
  p:empty { display: none; }
  p, a { font-size: .9rem; max-width: 32rem; }
  @media print { .pdf-action { display: none; } }
</style>
