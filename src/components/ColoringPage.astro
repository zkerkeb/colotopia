---
import PdfDownloadButton from "./PdfDownloadButton.astro";
import Breadcrumb from "./Breadcrumb.astro";
import RelatedColoriages from "./RelatedColoriages.astro";
import AffiliateWidget from "./AffiliateWidget.astro";
import BookRecommendation from "./BookRecommendation.astro";
import { recommendedBook } from "../lib/shop";
import {
  getLocalePath,
  getColoringBasePath,
  getCategoryLabel,
  getCategorySlug,
  type Locale,
  type Category,
} from "../lib/i18n";
import { coloringPreview } from "../lib/preview-images";
import { getCollections } from "../lib/collections";
interface Props {
  title: string;
  image: string;
  alt: string;
  category: Category;
  tags: string[];
  locale: Locale;
  slug: string;
  related?: { title: string; slug: string; image: string; alt: string }[];
}
const {
  title,
  image,
  alt,
  category,
  tags,
  locale,
  slug,
  related = [],
} = Astro.props;
const fr = locale === "fr";
const preview = await coloringPreview(image, "page");
const catLabel = getCategoryLabel(category, locale);
const catUrl = `${getLocalePath(locale, `/${getCategorySlug(category, locale)}`)}/`;
const pageUrl = `https://colotopia.com/${locale}/${getColoringBasePath(locale)}/${slug}/`;
const collections = (await getCollections(locale)).filter((c) =>
  c.items.some((i) => i.data.slug === slug),
);
const share = [
  {
    name: "Pinterest",
    url: `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(image)}&description=${encodeURIComponent(title)}`,
  },
  {
    name: "WhatsApp",
    url: `https://wa.me/?text=${encodeURIComponent(title + " " + pageUrl)}`,
  },
];
---

<article
  class="coloring-page"
  data-coloring-title={title}
  data-coloring-category={category}
  data-coloring-slug={slug}
  data-locale={locale}
  data-print-image={image}
>
  <Breadcrumb locale={locale} category={category} currentPage={title} />
  <h1>{title}</h1>
  <p class="page-meta">
    PDF A4 · {fr ? "Gratuit · Sans inscription" : "Free · No sign-up"}
  </p>
  <div class="page-layout">
    <div class="coloring-image-frame">
      <picture>
        <source media="print" type="image/png" srcset={image} />
        <source
          type="image/webp"
          srcset={preview.srcset}
          sizes="(max-width: 768px) 80vw, 560px"
        />
        <img
          src={preview.src}
          alt={alt}
          width={preview.width}
          height={preview.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-pin-media={image}
          data-pin-url={pageUrl}
        />
      </picture>
    </div>
    <aside
      class="download-panel"
      aria-label={fr ? "Télécharger et imprimer" : "Download and print"}
    >
      <div class="coloring-actions">
        <PdfDownloadButton
          image={image}
          title={title}
          locale={locale}
          showImageLink={false}
        />
        <div class="secondary-actions">
          <button class="print-button" id="print-btn" type="button">
            {fr ? "Imprimer" : "Print"}
          </button>
          <a href={image} target="_blank" rel="noopener noreferrer">
            {fr ? "Ouvrir le PNG" : "Open PNG"}
          </a>
        </div>
        <p id="print-status" role="status" aria-live="polite"></p>
      </div>
      <BookRecommendation locale={locale} category={category} />
      {!recommendedBook(category, locale) && <AffiliateWidget locale={locale} category={category} />}
      <a class="category-link" href={catUrl}>
        {fr
          ? `Voir les coloriages ${catLabel.toLowerCase()}`
          : `More ${catLabel.toLowerCase()} coloring pages`}{" "}
        →
      </a>
      {collections.map((c) => (
        <a class="collection-link" href={c.href}>
          {fr ? "Dans la collection : " : "In the collection: "}
          {c.short} →
        </a>
      ))}
    </aside>
  </div>
  <RelatedColoriages
    locale={locale}
    items={related}
    currentSlug={slug}
    category={category}
  />
  {recommendedBook(category, locale) && <details class="supplies"><summary>{fr ? 'Fournitures pour ce coloriage' : 'Coloring supplies'}</summary><AffiliateWidget locale={locale} category={category} placement="after_related" /></details>}
  <section class="about-coloring">
    <h2>{fr ? "À propos de ce coloriage" : "About this coloring page"}</h2>
    <p>
      {fr
        ? `« ${title} » est disponible gratuitement en PDF A4 et en PNG dans le thème ${catLabel.toLowerCase()}. Choisis les couleurs qui te plaisent et imprime uniquement les feuilles dont tu as besoin.`
        : `“${title}” is available as a free A4 PDF and PNG in our ${catLabel.toLowerCase()} theme. Choose the colors you like and print only the sheets you need.`}
    </p>
    <div class="coloring-tags">
      {tags.slice(0, 8).map((tag) => (
        <a
          class="tag tag--primary"
          href={`/${locale}/${fr ? "recherche" : "search"}/?q=${encodeURIComponent(tag)}`}
        >
          {tag}
        </a>
      ))}
    </div>
    <div class="share-section">
      <span>{fr ? "Partager ce dessin :" : "Share this page:"}</span>
      {share.map((s) => (
        <a
          href={s.url}
          class="share-btn"
          data-method={s.name.toLowerCase()}
          target="_blank"
          rel="noopener noreferrer"
        >
          {s.name}
        </a>
      ))}
    </div>
  </section>
  <div class="sticky-download" id="sticky-download" hidden>
    <button type="button" class="btn-primary">
      {fr ? "Télécharger le PDF" : "Download PDF"}
    </button>
  </div>
</article>
<script>
  import { track, trackColoringView } from "../lib/analytics";
  const article = document.querySelector<HTMLElement>(".coloring-page")!;
  trackColoringView({
    coloring_title: article.dataset.coloringTitle,
    coloring_category: article.dataset.coloringCategory,
    coloring_slug: article.dataset.coloringSlug,
  });
  const print = document.querySelector<HTMLButtonElement>("#print-btn")!;
  print.addEventListener("click", async () => {
    const status = document.querySelector<HTMLElement>("#print-status")!;
    print.disabled = true;
    status.textContent = "";
    try {
      const master = new Image();
      master.src = article.dataset.printImage!;
      await master.decode();
      track("print_intent", { coloring_slug: article.dataset.coloringSlug });
      window.print();
    } catch {
      status.textContent =
        article.dataset.locale === "fr"
          ? "Impression indisponible. Téléchargez le PDF pour l’imprimer."
          : "Printing unavailable. Download the PDF to print it.";
    } finally {
      print.disabled = false;
    }
  });
  const pdf = document.querySelector<HTMLButtonElement>("#pdf-download-btn")!;
  const sticky = document.querySelector<HTMLElement>("#sticky-download")!;
  const stickyButton = sticky.querySelector<HTMLButtonElement>("button")!;
  const update = () => {
    sticky.hidden = !(
      matchMedia("(max-width:768px)").matches &&
      pdf.getBoundingClientRect().bottom < 0
    );
    stickyButton.disabled = pdf.disabled;
  };
  new IntersectionObserver(update).observe(pdf);
  window.addEventListener("resize", update);
  new MutationObserver(update).observe(pdf, {
    attributes: true,
    attributeFilter: ["disabled"],
  });
  stickyButton.addEventListener("click", () => {
    pdf.scrollIntoView({ block: "center" });
    pdf.click();
  });
  document
    .querySelectorAll<HTMLAnchorElement>(".share-btn")
    .forEach((a) =>
      a.addEventListener("click", () =>
        track("share_click", {
          method: a.dataset.method,
          content_type: "coloring_page",
          item_id: location.pathname,
        }),
      ),
    );
</script>
<style>
  .supplies { margin-top: 2rem; max-width: 440px; }
  .supplies summary { cursor: pointer; font-weight: 800; margin-bottom: .75rem; }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.2;
    margin: 0.75rem 0;
  }
  .page-meta {
    color: #625e71;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }
  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: 2.5rem;
    align-items: start;
  }
  .coloring-image-frame {
    padding: 1rem;
    background: white;
    border: 1px solid #eae5ef;
    border-radius: 18px;
    box-shadow: 0 6px 24px #352d4b09;
    text-align: center;
  }
  .coloring-image-frame img {
    display: block;
    object-fit: contain;
    width: 100%;
    height: 540px;
  }
  .download-panel {
    min-width: 0;
  }
  .coloring-actions {
    padding: 1.5rem;
    background: #f0ebfc;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }
  .coloring-actions :global(.pdf-action) {
    align-items: stretch;
  }
  .coloring-actions :global(.btn-primary) {
    justify-content: center;
    min-height: 52px;
  }
  .secondary-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .secondary-actions a {
    font-size: 0.9rem;
  }
  .print-button {
    align-self: flex-start;
    color: var(--color-primary);
    border: 1px solid #bcb0ef;
    background: white;
    border-radius: 12px;
    padding: 0.65rem 1.25rem;
    min-height: 44px;
    cursor: pointer;
  }
  .category-link,
  .collection-link {
    display: block;
    font-weight: 800;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  .about-coloring {
    margin-top: 2rem;
    max-width: 50rem;
  }
  .about-coloring h2 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .coloring-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .share-section {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
  .sticky-download {
    position: fixed;
    z-index: 190;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    box-shadow: 0 -3px 15px #29253c15;
  }
  .sticky-download[hidden] {
    display: none;
  }
  .sticky-download button {
    width: 100%;
    justify-content: center;
  }
  #print-status:empty {
    display: none;
  }
  @media (max-width: 768px) {
    .page-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .coloring-image-frame {
      padding: 0.5rem;
    }
    .coloring-image-frame img {
      height: clamp(220px, 40vh, 350px);
    }
    .download-panel {
      padding: 0;
      background: none;
    }
    .coloring-actions {
      padding: 0;
      background: none;
    }
    .coloring-page {
      padding-bottom: 3rem;
    }
  }
  @media print {
    @page {
      size: A4 portrait;
      margin: 10mm;
    }
    .coloring-page > :not(.page-layout),
    .download-panel {
      display: none !important;
    }
    .page-layout {
      display: block !important;
    }
    .coloring-image-frame {
      padding: 0 !important;
      border: 0 !important;
      box-shadow: none !important;
      background: white !important;
      border-radius: 0 !important;
    }
    .coloring-image-frame img {
      width: 190mm !important;
      height: 277mm !important;
      object-fit: contain !important;
      display: block !important;
    }
    .coloring-page {
      padding: 0 !important;
    }
  }
</style>
