---
interface Props {
  name: string;
  slug?: string;
  emoji: string;
  count: number;
  color: string;
  href: string;
  locale?: string;
  image?: string;
  heading?: boolean;
}

const { name, emoji, count, color, href, locale = 'fr', image, heading = false } = Astro.props;
const countLabel = locale === 'fr'
  ? `${count} coloriage${count === 1 ? '' : 's'}`
  : `${count} coloring page${count === 1 ? '' : 's'}`;
const Label = heading ? 'h2' : 'span';
---

<a
  href={href}
  class={`category-card${image ? ' category-card--image' : ''}`}
  style={`--category-color: ${color}`}
  aria-label={`${name} — ${countLabel}`}
  data-fade-in
>
  {image
    ? <>
        <img class="category-cover" src={image} alt="" loading="lazy" decoding="async" width="600" height="600" />
        <div class="category-image-label">
          <Label class="category-name">{name}</Label>
          <span class="category-count">{countLabel}</span>
        </div>
      </>
    : <>
        <span class="category-emoji" aria-hidden="true">{emoji}</span>
        <span class="category-name">{name}</span>
        <span class="category-count">{countLabel}</span>
      </>
  }
</a>

<style>
  .category-card {
    background: var(--category-color, var(--color-accent-mint));
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-4) var(--space-5);
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    transition: box-shadow var(--transition-normal);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .category-card:hover {
    box-shadow: var(--shadow-card-hover);
    text-decoration: none;
  }

  .category-card--image {
    padding: 0;
    gap: 0;
    background: #fff;
  }

  .category-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    padding: var(--space-3);
    display: block;
    transition: transform 0.3s ease;
  }

  .category-card--image:hover .category-cover {
    transform: scale(1.04);
  }

  .category-image-label {
    width: 100%;
    flex: 1;
    min-height: 5rem;
    padding: var(--space-3);
    background: var(--category-color);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    justify-content: center;
  }

  .category-emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  .category-name {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.3;
  }

  .category-count {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: rgba(45, 52, 54, 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-cover { transition: none; }
    .category-card--image:hover .category-cover { transform: none; }
  }
</style>
