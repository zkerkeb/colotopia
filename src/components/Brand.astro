---
import { Image } from "astro:assets";
import logo from "../assets/colotopia-logo.png";
import type { Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<a
  class="brand"
  href={`/${locale}/`}
  aria-label={locale === "fr" ? "Colotopia — Accueil" : "Colotopia — Home"}
>
  <span class="mascot" aria-hidden="true">
    <Image src={logo} alt="" width={160} format="webp" quality={90} />
  </span>
  <span>Colotopia</span>
</a>
<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand:hover {
    text-decoration: none;
  }
  .mascot {
    display: block;
    width: 66px;
    height: 40px;
    overflow: hidden;
  }
  .mascot :global(img) {
    display: block;
    width: 80px;
    max-width: none;
    height: auto;
    margin-left: -7px;
  }
  @media (max-width: 400px) {
    .brand {
      font-size: 1.55rem;
      gap: 0.25rem;
    }
    .mascot {
      width: 56px;
    }
  }
</style>
