---
import Brand from "./Brand.astro";
import SearchBar from "./SearchBar.astro";
import { shopPath } from "../lib/shop";
import type { Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
  altUrl?: string;
}
const { locale, altUrl } = Astro.props;
const fr = locale === "fr";
const links = [
  {
    href: `/${locale}/categories/`,
    label: fr ? "Coloriages" : "Coloring pages",
  },
  { href: shopPath(locale), label: fr ? "Cahiers" : "Books" },
  { href: `/${locale}/collections/`, label: "Collections" },
  {
    href: `/${locale}/categories/#adults`,
    label: fr ? "Pour les adultes" : "For adults",
  },
];
const other = altUrl ? new URL(altUrl).pathname : fr ? "/en/" : "/fr/";
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <Brand locale={locale} />
    <nav
      class="desktop-nav"
      aria-label={fr ? "Navigation principale" : "Main navigation"}
    >
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a
        class="language"
        href={other}
        lang={fr ? "en" : "fr"}
        aria-label={fr ? "View in English" : "Voir en français"}
      >
        {fr ? "EN" : "FR"} <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <button
      id="hamburger-btn"
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label={fr ? "Ouvrir le menu" : "Open menu"}
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <dialog id="mobile-drawer" aria-label={fr ? "Menu principal" : "Main menu"}>
    <div class="drawer-top">
      <strong>Colotopia</strong>
      <button
        class="close-button"
        type="button"
        aria-label={fr ? "Fermer le menu" : "Close menu"}
      >
        ×
      </button>
    </div>
    <SearchBar locale={locale} showSubmit />
    <nav aria-label={fr ? "Navigation mobile" : "Mobile navigation"}>
      <a href={`/${locale}/`}>{fr ? "Accueil" : "Home"}</a>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={`/${locale}/blog/`}>
        {fr ? "Idées et conseils" : "Ideas and tips"}
      </a>
      <a href={other} lang={fr ? "en" : "fr"}>
        {fr ? "English" : "Français"}
      </a>
    </nav>
  </dialog>
</header>
<script>
  const trigger = document.querySelector<HTMLButtonElement>("#hamburger-btn")!;
  const drawer = document.querySelector<HTMLDialogElement>("#mobile-drawer")!;
  trigger.addEventListener("click", () => {
    drawer.showModal();
    trigger.setAttribute("aria-expanded", "true");
    document.documentElement.style.overflow = "hidden";
  });
  drawer
    .querySelector(".close-button")!
    .addEventListener("click", () => drawer.close());
  drawer.addEventListener("click", (event) => {
    if (event.target === drawer) {
      const r = drawer.getBoundingClientRect();
      if (
        event.clientX < r.left ||
        event.clientX > r.right ||
        event.clientY < r.top ||
        event.clientY > r.bottom
      )
        drawer.close();
    }
  });
  drawer
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => drawer.close()));
  drawer.addEventListener("close", () => {
    trigger.setAttribute("aria-expanded", "false");
    document.documentElement.style.overflow = "";
    trigger.focus();
  });
  matchMedia("(min-width: 769px)").addEventListener("change", (e) => {
    if (e.matches && drawer.open) drawer.close();
  });
</script>
<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #eee9f2;
  }
  .header-inner {
    max-width: 1200px;
    height: 76px;
    padding: 0 1rem;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.7rem;
  }
  nav a {
    color: var(--color-text);
    font-weight: 700;
    padding: 0.7rem 0;
  }
  .language {
    background: #f6f4fa;
    padding: 0.6rem 1rem;
    border-radius: 30px;
  }
  .menu-button,
  .close-button {
    background: #f6f4fa;
    color: var(--color-text);
    border: 0;
    border-radius: 12px;
    width: 44px;
    height: 44px;
    cursor: pointer;
  }
  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
  }
  dialog {
    position: fixed;
    inset: 0 0 0 auto;
    margin: 0;
    padding: 1.25rem;
    width: min(380px, 94vw);
    max-width: 94vw;
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }
  dialog::backdrop {
    background: #1e193c70;
  }
  .drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
    font-size: 1.5rem;
  }
  .close-button {
    font-size: 2rem;
  }
  dialog nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 1.25rem;
  }
  dialog nav a {
    padding: 0.8rem;
    border-radius: 12px;
  }
  dialog nav a:hover {
    background: #ede9ff;
  }
  @media (max-width: 768px) {
    .header-inner {
      height: 64px;
    }
    .desktop-nav {
      display: none;
    }
    .menu-button {
      display: flex;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
