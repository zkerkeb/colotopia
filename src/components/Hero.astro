---
import type { Locale } from "../lib/i18n";
import { coloringPreview } from "../lib/preview-images";
import SearchBar from "./SearchBar.astro";
interface Props {
  locale: Locale;
  previews?: { image: string; alt: string; slug: string }[];
}
const { locale, previews = [] } = Astro.props;
const fr = locale === "fr";
const images = await Promise.all(
  previews
    .slice(0, 3)
    .map(async (p) => ({
      ...p,
      preview: await coloringPreview(p.image, "hero"),
    })),
);
---

<section class="hero">
  <div class="hero-content">
    <h1>
      <span class="desktop-title">
        {fr ? "Des coloriages gratuits," : "Free coloring pages,"}
        <br />
        <span>{fr ? "prêts à imprimer." : "ready to print."}</span>
      </span>
      <span class="mobile-title">
        {fr ? "Un coloriage," : "Pick a coloring page,"}
        <br />
        {fr ? "et c’est parti !" : "and make it yours!"}
      </span>
    </h1>
    <p class="desktop-subtitle">
      {fr
        ? "Choisis ton dessin et télécharge ton PDF A4. Sans inscription."
        : "Choose a page and download your A4 PDF. No sign-up."}
    </p>
    <p class="mobile-subtitle">
      {fr ? "Gratuit · PDF A4 · Sans compte" : "Free · A4 PDF · No account"}
    </p>
    <SearchBar locale={locale} showSubmit />
  </div>
  <div class="paper-stack" aria-hidden="true">
    {images.map((p, i) => (
      <img
        src={p.preview.src}
        srcset={p.preview.srcset}
        sizes="180px"
        width="180"
        height="254"
        alt=""
        style={`--i:${i};--rotate:${[-12, 0, 12][i]}deg`}
        decoding="async"
      />
    ))}
  </div>
</section>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: 0.75rem 0 1rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 3.7vw, 3.1rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .desktop-title > span {
    color: var(--color-primary);
  }
  p {
    color: #625e71;
    margin: 1rem 0 1.5rem;
    font-size: 1.1rem;
    max-width: 38rem;
  }
  .mobile-title,
  .mobile-subtitle {
    display: none;
  }
  .paper-stack {
    position: relative;
    height: 200px;
    isolation: isolate;
  }
  .paper-stack::before {
    content: "";
    position: absolute;
    inset: 15px -5px;
    border-radius: 50%;
    background: linear-gradient(120deg, #e9e0ff, #e2f9ed);
    z-index: -1;
  }
  .paper-stack img {
    position: absolute;
    top: calc(15px + var(--i) * 4px);
    left: calc(var(--i) * 25%);
    width: 49%;
    height: 190px;
    object-fit: contain;
    background: white;
    padding: 8px;
    border-radius: 6px;
    box-shadow: 0 7px 20px #352d4b18;
    transform: rotate(var(--rotate));
  }
  @media (max-width: 768px) {
    .hero {
      display: block;
      padding: 0.5rem 0 1.25rem;
    }
    .paper-stack,
    .desktop-title,
    .desktop-subtitle {
      display: none;
    }
    .mobile-title,
    .mobile-subtitle {
      display: block;
    }
    h1 {
      font-size: 2.2rem;
      line-height: 1.12;
    }
    p {
      font-size: 0.95rem;
      margin: 0.75rem 0 1rem;
    }
  }
</style>
